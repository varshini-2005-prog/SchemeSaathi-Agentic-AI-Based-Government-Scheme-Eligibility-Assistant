# SchemeSaathi Environment Configuration Example

# Application Settings
APP_NAME=SchemeSaathi
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# Supported providers: openai, groq, google, local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=data/processed/faiss_index

# Database Path
DATABASE_URL=sqlite:///./schemesaathi.db

# Multi-language Settings
DEFAULT_LANGUAGE=ta-en
